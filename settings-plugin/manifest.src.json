{
  "id": "streamline-settings.reaplugin",
  "author": "Streamline",
  "name": "Streamline Settings",
  "description": "Streamline's settings page, ported to a standalone plugin so it can evolve independently of the skin. Settings: http://localhost:8080/api/v1/plugins/streamline-settings.reaplugin/ui",
  "version": "0.1.1",
  "apiVersion": 1,
  "permissions": [
    "log",
    "api",
    "emit",
    "pluginStorage"
  ],
  "settings": {},
  "api": [
    {
      "id": "ui",
      "type": "http",
      "data": {}
    },
    {
      "id": "app",
      "type": "http",
      "data": {}
    },
    {
      "id": "i18n.csv",
      "type": "http",
      "data": {}
    },
    {
      "id": "iro",
      "type": "http",
      "data": {}
    },
    {
      "id": "easymde",
      "type": "http",
      "data": {}
    },
    {
      "id": "easymde.css",
      "type": "http",
      "data": {}
    },
    {
      "id": "easymde-icons.css",
      "type": "http",
      "data": {}
    }
  ]
}
